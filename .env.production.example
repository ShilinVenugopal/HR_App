# Production environment for docker-compose.prod.yml.
#
# Copy this file to `.env` in the repo root (same directory as
# docker-compose.prod.yml) and fill in every value marked CHANGE ME.
# `.env` is gitignored — never commit your real secrets.
#
#   cp .env.production.example .env

# ── Domain ──────────────────────────────────────────────────────────────
# The domain this app will be reachable at. Point its DNS A record at
# your server's public IP *before* starting the stack — Caddy requests a
# Let's Encrypt certificate for this exact name on first boot.
DOMAIN=erp.foraysgroup.com

# ── Database ────────────────────────────────────────────────────────────
# Postgres runs in its own container on the internal Docker network only
# (never exposed to the internet). Pick a strong password — this is not
# your app login, it's the database credential.
DB_USER=hr_app
DB_PASSWORD=CHANGE_ME_use_a_long_random_password
DB_NAME=hr_app_db

# ── JWT signing secrets ─────────────────────────────────────────────────
# Generate two DIFFERENT long random strings, e.g.:
#   openssl rand -base64 48
# Anyone with these can forge login sessions — treat them like passwords.
# Rotating either one invalidates every existing session (forces re-login).
JWT_ACCESS_SECRET=CHANGE_ME_random_string_1
JWT_REFRESH_SECRET=CHANGE_ME_random_string_2
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# ── Security tuning (sane defaults — rarely need changing) ──────────────
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# ── Initial Super Admin account ──────────────────────────────────────────
# Created by `npm run seed` (see DEPLOYMENT.md — run once, after the first
# `docker compose up`). CHANGE this password before going live, and change
# it again via the app's own UI immediately after your first login — this
# value only matters for that very first login.
SUPER_ADMIN_EMAIL=admin@foraysgroup.com
SUPER_ADMIN_PASSWORD=CHANGE_ME_before_first_login

# ── Bulk Communication — Email (optional) ─────────────────────────────────
# Leave everything in this section blank to run with email sending
# disabled (everything else works; sends fail with a clear "not
# configured" reason instead of erroring).
#
# Two ways to send email — pick ONE:
#
# 1. BREVO_API_KEY (recommended for most cloud VPS hosts). Sends over
#    HTTPS (port 443) via Brevo's API instead of raw SMTP. Most cloud
#    providers — DigitalOcean, AWS, Azure, etc. — block outbound SMTP
#    ports (587/465/25) by default as an anti-spam measure, which makes
#    option 2 below unusable in production on those hosts. Sign up free at
#    brevo.com (300 emails/day free), verify a sender email/domain, and
#    create an API key under SMTP & API → API Keys.
BREVO_API_KEY=
BREVO_FROM_ADDRESS=
BREVO_FROM_NAME=FORAYS ERP
#
# 2. SMTP (only works if your host doesn't block outbound mail ports —
#    check with your provider first). Ignored automatically whenever
#    BREVO_API_KEY above is set.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=FORAYS ERP

# ── Bulk Communication — WhatsApp (optional) ──────────────────────────────
# Leave blank to run with WhatsApp sending disabled.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
