# Supabase project (Project Settings -> API). The anon key is designed to be
# public and is safe to bake into the desktop app: all access is enforced by
# Row Level Security. NEVER put the service-role key here.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-public-key

# E-mail domains shown/pre-checked on the login screen (comma-separated).
# Must match rows in the allowed_email_domains table, which is the real gate.
VITE_COMPANY_DOMAINS=foraysgroup.in

# Only used by `npm run create-admin` on an administrator's machine to create
# the very first Admin account. Not bundled into the app.
SUPABASE_SERVICE_ROLE_KEY=
