// Forays Group HR Solutions — Enterprise HR Management System
// Prisma schema: normalized RBAC + project-based data security model

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─────────────────────────────────────────────────────────────────────────
// ENUMS
// ─────────────────────────────────────────────────────────────────────────

enum Role {
  SUPER_ADMIN
  SITE_ADMIN
  HR_EXECUTIVE
  PROJECT_MANAGER
  FINANCE
  NORMAL_USER
  PROCUREMENT_ADMIN
  PROJECT_ENGINEER
  STORE_INCHARGE
  PURCHASE_TEAM
  ACCOUNTS
  SITE_USER
  APPROVER
}

enum UserStatus {
  ACTIVE
  DISABLED
}

enum ProjectStatus {
  ACTIVE
  INACTIVE
}

/// Every permission-checkable module in the sidebar / API surface.
enum ModuleName {
  DASHBOARD
  RECRUITMENT
  EMPLOYEES
  ATTENDANCE
  WAGES
  COMPLIANCE
  ADVANCES
  REPORTS
  SETTINGS
  USER_MANAGEMENT
  INVENTORY
  PURCHASE_REQUISITION
  PURCHASE_ORDER
  GRN
  PROCUREMENT_DASHBOARD
  BILLING_STATUS
  SITE_ACCOUNTS
}

enum CandidateStatus {
  APPLIED
  SCREENING
  INTERVIEW_SCHEDULED
  INTERVIEW_COMPLETED
  SELECTED
  REJECTED
  OFFER_RELEASED
  JOINED
  CANCELLED
}

enum InterviewStage {
  NOT_STARTED
  SCHEDULED
  COMPLETED
  PASSED
  FAILED
  ON_HOLD
}

enum EmployeeStatus {
  ACTIVE
  INACTIVE
  RESIGNED
  TERMINATED
  ON_LEAVE
  BLACKLISTED
}

enum Shift {
  DAY
  NIGHT
  GENERAL
}

enum AttendanceStatus {
  PRESENT
  ABSENT
  HALF_DAY
  LEAVE
  HOLIDAY
  WEEK_OFF
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PayrollStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  PAID
}

enum ComplianceType {
  PF
  ESIC
  INSURANCE
  LABOUR_LICENSE
  MEDICAL
}

enum ComplianceStatus {
  ACTIVE
  EXPIRED
  PENDING_RENEWAL
}

enum AdvanceType {
  ADVANCE
  LOAN
}

enum AdvanceStatus {
  PENDING
  APPROVED
  REJECTED
  CLOSED
}

enum AuditAction {
  LOGIN
  LOGOUT
  CREATE
  UPDATE
  DELETE
  APPROVE
  FAILED_LOGIN
  UNAUTHORIZED_ACCESS
  PASSWORD_RESET
  EXPORT
}

enum AuditStatus {
  SUCCESS
  FAILURE
}

enum CommChannel {
  EMAIL
  WHATSAPP
}

enum CommBatchStatus {
  QUEUED
  SENDING
  COMPLETED
  FAILED
  CANCELLED
}

enum CommMessageStatus {
  QUEUED
  SENDING
  SENT
  DELIVERED
  OPENED
  FAILED
  BOUNCED
  CANCELLED
}

// ── Procurement ────────────────────────────────────────────────────────

enum Unit {
  NOS
  MTR
  LOT
  EA
  KG
  TON
  LITER
}

enum PRStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  RETURNED
}

enum POStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  REJECTED
}

enum GRNStatus {
  DRAFT
  SUBMITTED
  PENDING_APPROVAL
  APPROVED
  REJECTED
  RETURNED
}

/// Shared by Approval, Notification and DocumentSequence — a lightweight
/// polymorphic discriminator rather than 3 near-identical enums.
enum ProcurementDocType {
  PR
  PO
  GRN
}

enum ApprovalAction {
  SUBMIT
  APPROVE
  REJECT
  RETURN
}

enum InventoryTransactionType {
  GRN_RECEIPT
  MANUAL_ADJUSTMENT
}

enum NotificationType {
  PR_SUBMITTED
  PR_APPROVED
  PR_REJECTED
  PR_RETURNED
  PO_PENDING
  PO_APPROVED
  PO_REJECTED
  GRN_PENDING
  GRN_APPROVED
  GRN_REJECTED
  GRN_RETURNED
  INVENTORY_UPDATED
}

enum NotificationChannel {
  DASHBOARD
  EMAIL
  WHATSAPP
}

/// Attachment owners include Vendor in addition to the 3 procurement
/// documents (vendor quotations/certificates aren't tied to one PR/PO/GRN).
enum AttachmentOwnerType {
  PR
  PO
  GRN
  VENDOR
}

/// The billing workflow progresses strictly forward through these values
/// over the life of one BillingItem row — controlled values rather than
/// free text so the status summary/filter dropdowns stay meaningful.
enum BillingItemStatus {
  PENDING_CERTIFICATION
  A1_PENDING
  A2_PENDING
  ACCOUNTS_PENDING
  INVOICE_DONE
}

/// DRAFT is freely editable by the site team (canEdit). Once SAVED, the
/// site team can no longer edit it — only a user holding canApprove on
/// SITE_ACCOUNTS (granted by Super Admin for corrections, per the design
/// brief) may still modify it. There is no revert-to-DRAFT step; a
/// correction is made in place while the statement stays SAVED.
enum SiteAccountStatementStatus {
  DRAFT
  SAVED
}

/// EXPENSE entries post against a static SiteAccountCostCode row (the
/// F01-F24 hierarchy). OTHER_RECEIPT entries are free-text fund/deposit
/// lines in the statement's header block (Opening Balance and Site Fund
/// Received are their own fields on SiteAccountStatement, not entries —
/// see the model comment — so OTHER_RECEIPT only covers additional ad-hoc
/// receipt/deposit lines beyond those two).
enum SiteAccountEntryType {
  OTHER_RECEIPT
  EXPENSE
}

// ─────────────────────────────────────────────────────────────────────────
// RBAC CORE
// ─────────────────────────────────────────────────────────────────────────

model User {
  id                String     @id @default(uuid())
  name              String
  email             String     @unique
  mobile            String
  passwordHash      String
  role              Role
  status            UserStatus @default(ACTIVE)
  lastLoginAt       DateTime?
  mustResetPassword Boolean    @default(false)
  createdById       String?
  createdBy         User?      @relation("UserCreatedBy", fields: [createdById], references: [id])
  createdUsers      User[]     @relation("UserCreatedBy")
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt

  projects      UserProject[]
  permissions   Permission[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  approvedAttendance   Attendance[]            @relation("AttendanceApprover")
  approvedWages        WageRecord[]            @relation("WageApprover")
  approvedAdvances     Advance[]               @relation("AdvanceApprover")
  createdCandidates    RecruitmentCandidate[]  @relation("CandidateCreatedBy")
  createdCommTemplates CommunicationTemplate[] @relation("CommTemplateCreatedBy")
  createdCommBatches   CommunicationBatch[]    @relation("CommBatchCreatedBy")
  wageUploads          WageUpload[]            @relation("WageUploadedBy")

  inventoryItemsCreated          InventoryItem[]        @relation("InventoryItemCreatedBy")
  inventoryTransactionsPerformed InventoryTransaction[] @relation("InventoryTxPerformedBy")
  prsRequested                   PurchaseRequisition[]  @relation("PRRequester")
  prsApproving                   PurchaseRequisition[]  @relation("PRCurrentApprover")
  posCreated                     PurchaseOrder[]        @relation("POCreatedBy")
  posApproved                    PurchaseOrder[]        @relation("POApprovedBy")
  grnsSubmitted                  GoodsReceivedNote[]    @relation("GRNSubmittedBy")
  grnsApproving                  GoodsReceivedNote[]    @relation("GRNCurrentApprover")
  grnsInventoryUpdated           GoodsReceivedNote[]    @relation("GRNInventoryUpdatedBy")
  approvalsActed                 Approval[]             @relation("ApprovalActedBy")
  attachmentsUploaded            Attachment[]           @relation("AttachmentUploadedBy")
  notifications                  Notification[]

  billingRecordsCreated BillingRecord[] @relation("BillingRecordCreatedBy")
  billingRecordsUpdated BillingRecord[] @relation("BillingRecordUpdatedBy")
  billingItemsCreated   BillingItem[]   @relation("BillingItemCreatedBy")
  billingItemsUpdated   BillingItem[]   @relation("BillingItemUpdatedBy")

  siteAccountStatementsCreated SiteAccountStatement[] @relation("SiteAccountStatementCreatedBy")
  siteAccountStatementsUpdated SiteAccountStatement[] @relation("SiteAccountStatementUpdatedBy")
  siteAccountEntriesCreated    SiteAccountEntry[]      @relation("SiteAccountEntryCreatedBy")
  siteAccountEntriesUpdated    SiteAccountEntry[]      @relation("SiteAccountEntryUpdatedBy")

  costCodesCreated CostCode[] @relation("CostCodeCreatedBy")
  costCodesUpdated CostCode[] @relation("CostCodeUpdatedBy")

  @@index([role])
  @@index([status])
  @@map("users")
}

model Project {
  id            String        @id @default(uuid())
  projectName   String
  clientName    String
  location      String?
  /// Client-facing project/site number — shown on printed procurement
  /// documents (Purchase Requisition, PO, GRN headers all show "Project
  /// Number"). Optional since it predates the Procurement module; projects
  /// without one show a blank field on those printouts.
  projectNumber String?
  status        ProjectStatus @default(ACTIVE)
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  users           UserProject[]
  employees       Employee[]
  candidates      RecruitmentCandidate[]
  attendance      Attendance[]
  wages           WageRecord[]
  compliance      Compliance[]
  advances        Advance[]
  auditLogs       AuditLog[]
  commMessageLogs CommunicationMessageLog[]
  wageTemplate    WageProjectTemplate?
  wageEntries     WageEntry[]

  inventoryItems        InventoryItem[]
  inventoryTransactions InventoryTransaction[]
  purchaseRequisitions  PurchaseRequisition[]
  purchaseOrders        PurchaseOrder[]
  goodsReceivedNotes    GoodsReceivedNote[]
  documentSequences     DocumentSequence[]
  billingRecords        BillingRecord[]
  siteAccountStatements SiteAccountStatement[]

  @@index([status])
  @@map("projects")
}

/// Many-to-many: which projects a user is allowed to access.
model UserProject {
  id        String   @id @default(uuid())
  userId    String
  projectId String
  createdAt DateTime @default(now())

  user    User    @relation(fields: [userId], references: [id], onDelete: Cascade)
  project Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  @@unique([userId, projectId])
  @@index([userId])
  @@index([projectId])
  @@map("user_projects")
}

/// Per-user, per-module CRUD + approval permission matrix.
/// Never hardcode permissions in code — always read from this table.
model Permission {
  id         String     @id @default(uuid())
  userId     String
  module     ModuleName
  canView    Boolean    @default(false)
  canAdd     Boolean    @default(false)
  canEdit    Boolean    @default(false)
  canDelete  Boolean    @default(false)
  canApprove Boolean    @default(false)
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, module])
  @@index([userId])
  @@index([module])
  @@map("permissions")
}

model RefreshToken {
  id        String   @id @default(uuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revoked   Boolean  @default(false)
  ipAddress String?
  userAgent String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

model AuditLog {
  id        String      @id @default(uuid())
  userId    String?
  userEmail String?
  action    AuditAction
  module    ModuleName?
  projectId String?
  ipAddress String?
  device    String?
  browser   String?
  status    AuditStatus
  details   Json?
  createdAt DateTime    @default(now())

  user    User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  project Project? @relation(fields: [projectId], references: [id], onDelete: SetNull)

  @@index([userId])
  @@index([projectId])
  @@index([module])
  @@index([action])
  @@index([createdAt])
  @@map("audit_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// MASTERS
// ─────────────────────────────────────────────────────────────────────────

model Department {
  id        String        @id @default(uuid())
  name      String        @unique
  status    ProjectStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  employees            Employee[]
  purchaseRequisitions PurchaseRequisition[]

  @@map("departments")
}

model Designation {
  id        String        @id @default(uuid())
  name      String        @unique
  status    ProjectStatus @default(ACTIVE)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  employees  Employee[]
  candidates RecruitmentCandidate[]

  @@map("designations")
}

// ─────────────────────────────────────────────────────────────────────────
// RECRUITMENT
// ─────────────────────────────────────────────────────────────────────────

model RecruitmentCandidate {
  id                    String          @id @default(uuid())
  candidateName         String
  contactNumber         String
  dateOfBirth           DateTime?
  qualification         String?
  experience            String?
  designationId         String?
  email                 String?
  projectId             String?
  resumeUrl             String?
  foraysInterviewStatus InterviewStage  @default(NOT_STARTED)
  clientInterviewStatus InterviewStage  @default(NOT_STARTED)
  remarks               String?
  status                CandidateStatus @default(APPLIED)
  createdById           String?
  createdAt             DateTime        @default(now())
  updatedAt             DateTime        @updatedAt

  project         Project?                  @relation(fields: [projectId], references: [id])
  designation     Designation?              @relation(fields: [designationId], references: [id])
  createdBy       User?                     @relation("CandidateCreatedBy", fields: [createdById], references: [id])
  employee        Employee?
  commMessageLogs CommunicationMessageLog[]

  @@index([projectId])
  @@index([status])
  @@index([designationId])
  @@map("recruitment_candidates")
}

// ─────────────────────────────────────────────────────────────────────────
// RECRUITMENT — BULK COMMUNICATION
//
// Deliberately 3 tables, not the 7 a naive reading of "queue/history/
// scheduled/logs" might suggest: CommunicationMessageLog.status is a single
// state machine (QUEUED -> SENDING -> SENT/FAILED -> DELIVERED/OPENED/
// BOUNCED) that IS the queue while status=QUEUED and IS the history once
// terminal, and `scheduledAt` on the same row is what "scheduled messages"
// means — a QUEUED row whose scheduledAt is in the future. Attachments are
// a JSON array on the batch (same pattern as Employee.documents), not a
// separate table. Fine-grained audit trail reuses the existing AuditLog
// table via its `details` JSON, not a parallel audit system.
// ─────────────────────────────────────────────────────────────────────────

model CommunicationTemplate {
  id          String      @id @default(uuid())
  name        String
  channel     CommChannel
  /// Free-text grouping (e.g. "Interview Call", "Offer Letter") — not an
  /// enum, since email and WhatsApp template categories overlap but aren't
  /// identical and new categories shouldn't require a migration.
  category    String?
  /// Only meaningful for EMAIL; WhatsApp messages have no subject line.
  subject     String?
  body        String
  createdById String?
  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  createdBy User?                @relation("CommTemplateCreatedBy", fields: [createdById], references: [id])
  batches   CommunicationBatch[]

  @@index([channel])
  @@map("communication_templates")
}

/// One "Send Bulk Email/WhatsApp" action. Fans out into one
/// CommunicationMessageLog per selected candidate.
model CommunicationBatch {
  id              String          @id @default(uuid())
  channel         CommChannel
  templateId      String?
  subject         String?
  body            String
  /// [{ name, url }] — uploaded via the existing /uploads endpoint.
  attachments     Json?
  /// Null = send now. A future timestamp = scheduled.
  scheduledAt     DateTime?
  status          CommBatchStatus @default(QUEUED)
  totalRecipients Int             @default(0)
  sentCount       Int             @default(0)
  deliveredCount  Int             @default(0)
  openedCount     Int             @default(0)
  failedCount     Int             @default(0)
  bouncedCount    Int             @default(0)
  createdById     String?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  template  CommunicationTemplate?    @relation(fields: [templateId], references: [id])
  createdBy User?                     @relation("CommBatchCreatedBy", fields: [createdById], references: [id])
  messages  CommunicationMessageLog[]

  @@index([channel])
  @@index([status])
  @@index([scheduledAt])
  @@map("communication_batches")
}

/// One row per candidate per batch. This is simultaneously the send queue
/// (status=QUEUED, picked up by the worker), the delivery tracker (status
/// transitions through SENT/DELIVERED/OPENED/FAILED/BOUNCED), and the
/// communication-history / candidate-timeline source (queried directly).
model CommunicationMessageLog {
  id                String            @id @default(uuid())
  batchId           String
  candidateId       String
  /// Denormalized from the candidate at send time so history stays
  /// correctly project-scoped even if the candidate is later reassigned.
  projectId         String?
  channel           CommChannel
  recipientEmail    String?
  recipientPhone    String?
  subject           String?
  /// Final rendered content — placeholders already substituted.
  body              String
  status            CommMessageStatus @default(QUEUED)
  /// External id from the provider (SMTP envelope id / Meta message id),
  /// used to correlate inbound webhook delivery events back to this row.
  providerMessageId String?
  errorReason       String?
  attempts          Int               @default(0)
  scheduledAt       DateTime?
  sentAt            DateTime?
  deliveredAt       DateTime?
  openedAt          DateTime?
  failedAt          DateTime?
  bouncedAt         DateTime?
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  batch     CommunicationBatch   @relation(fields: [batchId], references: [id], onDelete: Cascade)
  candidate RecruitmentCandidate @relation(fields: [candidateId], references: [id], onDelete: Cascade)
  project   Project?             @relation(fields: [projectId], references: [id])

  @@index([batchId])
  @@index([candidateId])
  @@index([projectId])
  @@index([status])
  @@index([scheduledAt])
  @@map("communication_message_logs")
}

// ─────────────────────────────────────────────────────────────────────────
// EMPLOYEES
// ─────────────────────────────────────────────────────────────────────────

model Employee {
  id                 String         @id @default(uuid())
  employeeCode       String         @unique
  name               String
  fatherName         String?
  contactNumber      String
  email              String?
  dateOfBirth        DateTime?
  departmentId       String?
  designationId      String?
  projectId          String
  joiningDate        DateTime?
  reportingManagerId String?
  panNumber          String?
  aadhaarNumber      String?        @unique
  passportNumber     String?
  pfNumber           String?
  uanNumber          String?
  esicNumber         String?
  bankAccountNumber  String?
  bankIfscCode       String?
  bankName           String?
  bankAccountName    String?
  address            String?
  documents          Json?
  status             EmployeeStatus @default(ACTIVE)
  candidateId        String?        @unique
  createdAt          DateTime       @default(now())
  updatedAt          DateTime       @updatedAt

  project          Project               @relation(fields: [projectId], references: [id])
  department       Department?           @relation(fields: [departmentId], references: [id])
  designation      Designation?          @relation(fields: [designationId], references: [id])
  reportingManager Employee?             @relation("EmployeeReportingManager", fields: [reportingManagerId], references: [id])
  subordinates     Employee[]            @relation("EmployeeReportingManager")
  candidate        RecruitmentCandidate? @relation(fields: [candidateId], references: [id])

  attendance Attendance[]
  wages      WageRecord[]
  compliance Compliance[]
  advances   Advance[]

  @@index([projectId])
  @@index([status])
  @@index([departmentId])
  @@index([designationId])
  @@map("employees")
}

// ─────────────────────────────────────────────────────────────────────────
// ATTENDANCE
// ─────────────────────────────────────────────────────────────────────────

model Attendance {
  id             String           @id @default(uuid())
  employeeId     String
  projectId      String
  date           DateTime
  shift          Shift            @default(GENERAL)
  inTime         String?
  outTime        String?
  status         AttendanceStatus @default(PRESENT)
  overtimeHours  Decimal          @default(0) @db.Decimal(5, 2)
  approvalStatus ApprovalStatus   @default(PENDING)
  approvedById   String?
  approvedAt     DateTime?
  isLocked       Boolean          @default(false)
  remarks        String?
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id])
  project    Project  @relation(fields: [projectId], references: [id])
  approvedBy User?    @relation("AttendanceApprover", fields: [approvedById], references: [id])

  @@unique([employeeId, date])
  @@index([projectId])
  @@index([date])
  @@index([approvalStatus])
  @@map("attendance")
}

// ─────────────────────────────────────────────────────────────────────────
// WAGES / PAYROLL
// ─────────────────────────────────────────────────────────────────────────

model WageRecord {
  id              String        @id @default(uuid())
  employeeId      String
  projectId       String
  month           Int
  year            Int
  presentDays     Decimal       @default(0) @db.Decimal(5, 2)
  overtimeHours   Decimal       @default(0) @db.Decimal(6, 2)
  basicWage       Decimal       @default(0) @db.Decimal(12, 2)
  allowances      Decimal       @default(0) @db.Decimal(12, 2)
  overtimeAmount  Decimal       @default(0) @db.Decimal(12, 2)
  grossWage       Decimal       @default(0) @db.Decimal(12, 2)
  pfDeduction     Decimal       @default(0) @db.Decimal(12, 2)
  esicDeduction   Decimal       @default(0) @db.Decimal(12, 2)
  advanceRecovery Decimal       @default(0) @db.Decimal(12, 2)
  otherDeductions Decimal       @default(0) @db.Decimal(12, 2)
  netWage         Decimal       @default(0) @db.Decimal(12, 2)
  status          PayrollStatus @default(DRAFT)
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  employee   Employee @relation(fields: [employeeId], references: [id])
  project    Project  @relation(fields: [projectId], references: [id])
  approvedBy User?    @relation("WageApprover", fields: [approvedById], references: [id])

  @@unique([employeeId, month, year])
  @@index([projectId])
  @@index([month, year])
  @@index([status])
  @@map("wage_records")
}

// ─────────────────────────────────────────────────────────────────────────
// COMPLIANCE
// ─────────────────────────────────────────────────────────────────────────

model Compliance {
  id              String           @id @default(uuid())
  projectId       String
  employeeId      String?
  type            ComplianceType
  referenceNumber String?
  validFrom       DateTime?
  validTo         DateTime?
  status          ComplianceStatus @default(ACTIVE)
  remarks         String?
  createdAt       DateTime         @default(now())
  updatedAt       DateTime         @updatedAt

  project  Project   @relation(fields: [projectId], references: [id])
  employee Employee? @relation(fields: [employeeId], references: [id])

  @@index([projectId])
  @@index([type])
  @@index([validTo])
  @@map("compliance")
}

// ─────────────────────────────────────────────────────────────────────────
// ADVANCES / LOANS / RECOVERIES
// ─────────────────────────────────────────────────────────────────────────

model Advance {
  id              String        @id @default(uuid())
  employeeId      String
  projectId       String
  type            AdvanceType   @default(ADVANCE)
  amount          Decimal       @db.Decimal(12, 2)
  reason          String?
  installments    Int           @default(1)
  recoveredAmount Decimal       @default(0) @db.Decimal(12, 2)
  status          AdvanceStatus @default(PENDING)
  approvedById    String?
  approvedAt      DateTime?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  employee   Employee          @relation(fields: [employeeId], references: [id])
  project    Project           @relation(fields: [projectId], references: [id])
  approvedBy User?             @relation("AdvanceApprover", fields: [approvedById], references: [id])
  recoveries AdvanceRecovery[]

  @@index([projectId])
  @@index([employeeId])
  @@index([status])
  @@map("advances")
}

model AdvanceRecovery {
  id        String   @id @default(uuid())
  advanceId String
  month     Int
  year      Int
  amount    Decimal  @db.Decimal(12, 2)
  createdAt DateTime @default(now())

  advance Advance @relation(fields: [advanceId], references: [id], onDelete: Cascade)

  @@index([advanceId])
  @@map("advance_recoveries")
}

// ─────────────────────────────────────────────────────────────────────────
// PROJECT-WISE WAGES (template-driven)
//
// Every client project can have its own wage-sheet layout — different
// column sets, different salary/deduction formulas. Rather than a fixed
// schema per project, one project (WageProjectTemplate) owns an ordered
// JSON column definition (labels, sections, which columns are computed and
// by what formula) that both the frontend grid and the backend formula
// engine read. Adding a new project's wages page is a data change (a new
// template row), not a schema change.
//
// "Monthly Wage Summary" from the design brief is intentionally NOT a
// stored table — it's a live aggregate over WageEntry so it can never go
// stale when rows are edited/added/deleted (no sync code required).
// ─────────────────────────────────────────────────────────────────────────

enum WageUploadStatus {
  PROCESSING
  COMPLETED
  FAILED
}

model WageProjectTemplate {
  id        String   @id @default(uuid())
  projectId String   @unique
  code      String   @unique
  name      String
  columns   Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  project Project      @relation(fields: [projectId], references: [id])
  uploads WageUpload[]
  entries WageEntry[]

  @@map("wage_project_templates")
}

model WageUpload {
  id           String           @id @default(uuid())
  templateId   String
  month        Int
  year         Int
  fileName     String
  fileUrl      String
  status       WageUploadStatus @default(PROCESSING)
  totalRows    Int              @default(0)
  importedRows Int              @default(0)
  failedRows   Int              @default(0)
  errorReport  Json?
  uploadedById String
  createdAt    DateTime         @default(now())

  template   WageProjectTemplate @relation(fields: [templateId], references: [id])
  uploadedBy User                @relation("WageUploadedBy", fields: [uploadedById], references: [id])
  entries    WageEntry[]

  @@index([templateId, month, year])
  @@map("wage_uploads")
}

model WageEntry {
  id              String   @id @default(uuid())
  templateId      String
  projectId       String
  uploadId        String?
  month           Int
  year            Int
  employeeCode    String
  employeeName    String
  data            Json
  grossSalary     Decimal  @default(0) @db.Decimal(12, 2)
  totalDeductions Decimal  @default(0) @db.Decimal(12, 2)
  netSalary       Decimal  @default(0) @db.Decimal(12, 2)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  template WageProjectTemplate @relation(fields: [templateId], references: [id])
  project  Project             @relation(fields: [projectId], references: [id])
  upload   WageUpload?         @relation(fields: [uploadId], references: [id])

  @@unique([templateId, month, year, employeeCode])
  @@index([templateId, month, year])
  @@index([projectId])
  @@map("wage_entries")
}

// ─────────────────────────────────────────────────────────────────────────
// PROCUREMENT — Inventory, Purchase Requisition, Purchase Order, GRN
//
// Every operational table here carries projectId (the one architectural
// rule — see CLAUDE.md) and is scoped via the same projectScopeWhere /
// assertProjectAccess primitives used by every other module. Approver
// eligibility is NOT a separate "approval hierarchy" table — it's exactly
// the existing Permission.canApprove flag on PURCHASE_REQUISITION /
// PURCHASE_ORDER / GRN, scoped to the approver's assigned projects. "Super
// Admin configures the approval hierarchy" from the design brief means
// Super Admin grants canApprove per user per module in User Management,
// same mechanism every other module already uses — no new config table.
//
// CostCode is a master table (like Department/Designation) — the 8
// categories (F05A/F05D/F07A/F08/F09/F10/F11/F12) from the client's real
// PUR-01.xlsx purchase-requisition template. PR items reference it via
// costCodeId; the printed PR groups items by category using that same
// relation, so the fixed A–H section layout never has to be duplicated
// as data.
//
// Approval, Notification and Attachment are intentionally NOT modeled
// with a Prisma relation back to PurchaseRequisition/PurchaseOrder/
// GoodsReceivedNote — they're polymorphic across the 3 document types
// (plus Vendor for Attachment), which Prisma can't express as a typed
// relation. They carry (documentType/ownerType, documentId/ownerId) and
// are looked up by that composite index instead.
// ─────────────────────────────────────────────────────────────────────────

/// The single source of truth for cost codes across the app — Inventory,
/// Purchase Requisition, Purchase Order and GRN line items all reference
/// this same table via costCodeId rather than each maintaining their own
/// list. Mutations are Super-Admin-only (see costCodes.routes.ts); every
/// other authenticated user has read-only access, since Recruitment/
/// Employees-style "any user may read reference data" doesn't apply here —
/// this master specifically must not be editable by non-Super-Admins.
model CostCode {
  id        String        @id @default(uuid())
  code      String        @unique
  name      String
  /// Supplementary fields carried over from the reference "Cost Code
  /// Summary" import — optional since most codes only ever need code+name.
  itemsToConsider   String?
  remarks           String?
  responsiblePerson String?
  status            ProjectStatus @default(ACTIVE)
  createdById       String?
  updatedById       String?
  createdAt         DateTime      @default(now())
  updatedAt         DateTime      @updatedAt

  createdBy User? @relation("CostCodeCreatedBy", fields: [createdById], references: [id])
  updatedBy User? @relation("CostCodeUpdatedBy", fields: [updatedById], references: [id])

  inventoryItems InventoryItem[]
  prItems        PurchaseRequisitionItem[]
  poItems        PurchaseOrderItem[]
  grnItems       GoodsReceivedNoteItem[]

  @@map("cost_codes")
}

model Vendor {
  id            String   @id @default(uuid())
  name          String
  address       String?
  gstNumber     String?
  email         String?
  phone         String?
  contactPerson String?
  active        Boolean  @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  purchaseOrders PurchaseOrder[]

  @@index([name])
  @@map("vendors")
}

model InventoryItem {
  id                 String   @id @default(uuid())
  projectId          String
  costCodeId         String
  itemDescription    String
  unit               Unit
  workingQuantity    Decimal  @default(0) @db.Decimal(14, 2)
  nonWorkingQuantity Decimal  @default(0) @db.Decimal(14, 2)
  remarks            String?
  date               DateTime @default(now())
  createdById        String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  project      Project                @relation(fields: [projectId], references: [id])
  costCode     CostCode               @relation(fields: [costCodeId], references: [id])
  createdBy    User?                  @relation("InventoryItemCreatedBy", fields: [createdById], references: [id])
  transactions InventoryTransaction[]

  @@unique([projectId, costCodeId, itemDescription])
  @@index([projectId])
  @@index([costCodeId])
  @@map("inventory_items")
}

/// Every change to an inventory item's quantities — a manual adjustment or
/// a GRN receipt — is logged here, independent of the generic AuditLog
/// (which tracks security/permission events, not domain-level quantity
/// history). "Inventory transaction history maintained" from the design
/// brief refers to this table.
model InventoryTransaction {
  id                  String                   @id @default(uuid())
  inventoryItemId     String
  projectId           String
  type                InventoryTransactionType
  workingQtyChange    Decimal                  @default(0) @db.Decimal(14, 2)
  nonWorkingQtyChange Decimal                  @default(0) @db.Decimal(14, 2)
  /// Rejected quantity from a GRN receipt — recorded here for audit
  /// history only. It never adds to workingQuantity/nonWorkingQuantity
  /// (rejected material isn't usable stock), per the design brief's
  /// "Rejected quantity recorded separately."
  rejectedQtyChange   Decimal                  @default(0) @db.Decimal(14, 2)
  workingQtyAfter     Decimal                  @db.Decimal(14, 2)
  nonWorkingQtyAfter  Decimal                  @db.Decimal(14, 2)
  referenceGrnId      String?
  remarks             String?
  performedById       String?
  createdAt           DateTime                 @default(now())

  inventoryItem InventoryItem      @relation(fields: [inventoryItemId], references: [id])
  project       Project            @relation(fields: [projectId], references: [id])
  performedBy   User?              @relation("InventoryTxPerformedBy", fields: [performedById], references: [id])
  grn           GoodsReceivedNote? @relation(fields: [referenceGrnId], references: [id])

  @@index([inventoryItemId])
  @@index([projectId])
  @@index([referenceGrnId])
  @@map("inventory_transactions")
}

/// requestNumber is the system's own auto-generated reference (via
/// DocumentSequence, unique per project) used everywhere in-app for
/// identification/search. prNumber is the separate, manually-typed field
/// on the printed form ("PURCHASE REQ. NO. :-" in PUR-01.xlsx) — site
/// staff's own paper-based numbering, which the design brief also called
/// out as manual entry. Both exist because the brief asked for both.
model PurchaseRequisition {
  id                String    @id @default(uuid())
  projectId         String
  requestNumber     String
  prNumber          String?
  requesterId       String
  departmentId      String?
  /// Freeform named-individual fields from the printed form's header
  /// ("NAME OF SITE INCHARGE :-" / "NAME OF STORE INCHARGE :-" in
  /// PUR-01.xlsx) — distinct from `requesterId` (the logged-in system
  /// user), since the person named on paper isn't always the same as
  /// whoever has the login.
  siteInchargeName  String?
  storeInchargeName String?
  status            PRStatus  @default(DRAFT)
  currentApproverId String?
  submittedAt       DateTime?
  decidedAt         DateTime?
  createdAt         DateTime  @default(now())
  updatedAt         DateTime  @updatedAt

  project         Project                   @relation(fields: [projectId], references: [id])
  department      Department?               @relation(fields: [departmentId], references: [id])
  requester       User                      @relation("PRRequester", fields: [requesterId], references: [id])
  currentApprover User?                     @relation("PRCurrentApprover", fields: [currentApproverId], references: [id])
  items           PurchaseRequisitionItem[]
  purchaseOrders  PurchaseOrder[]

  @@unique([projectId, requestNumber])
  @@index([projectId])
  @@index([status])
  @@index([requesterId])
  @@map("purchase_requisitions")
}

/// Columns mirror PUR-01.xlsx exactly: SR.NO (row order), Cost Code,
/// MATERIAL NAME, UNIT, TOTAL REQ. QTY, MAKE, MODEL NO., QTY AVAILABLE AT
/// SITE, BAL. QTY REQ., REMARKS. The template's 8 fixed category sections
/// (A–H) are not separate stored data — they fall out of grouping items by
/// costCode (each category = one cost code, e.g. F05A = "Tools Tackles/
/// Power Tools").
model PurchaseRequisitionItem {
  id                 String   @id @default(uuid())
  prId               String
  costCodeId         String
  materialName       String
  unit               Unit
  totalReqQty        Decimal  @db.Decimal(14, 2)
  make               String?
  modelNo            String?
  qtyAvailableAtSite Decimal  @default(0) @db.Decimal(14, 2)
  balQtyReq          Decimal  @db.Decimal(14, 2)
  remarks            String?
  sortOrder          Int      @default(0)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  pr       PurchaseRequisition @relation(fields: [prId], references: [id], onDelete: Cascade)
  costCode CostCode            @relation(fields: [costCodeId], references: [id])

  @@index([prId])
  @@index([costCodeId])
  @@map("pr_items")
}

/// poNumber is manually entered (per the design brief's explicit override
/// for PO, unlike PR's dual-number approach) — unique per project, not
/// globally, since different sites may reuse their own paper numbering.
model PurchaseOrder {
  id                    String    @id @default(uuid())
  projectId             String
  prId                  String?
  poNumber              String
  /// The printed "P.O. Date" field — distinct from createdAt (which is
  /// when the draft row was first saved); this is the date shown/used on
  /// the document itself, and what Search-by-Month/Year filters against.
  poDate                DateTime  @default(now())
  vendorId              String
  enquiryNoDate         String?
  quotationNo           String?
  ref                   String?
  jobNo                 String?
  deliveryDate          DateTime?
  packingForwarding     Decimal   @default(0) @db.Decimal(12, 2)
  transportationCharges Decimal   @default(0) @db.Decimal(12, 2)
  taxesAndDuties        Decimal   @default(0) @db.Decimal(12, 2)
  subtotal              Decimal   @default(0) @db.Decimal(14, 2)
  grandTotal            Decimal   @default(0) @db.Decimal(14, 2)
  billingAddress        String?
  billingGstNumber      String?
  /// Overrides of the fixed Terms 1-11 (defaults live in code, not DB) —
  /// only populated when an authorized user actually edits a term.
  termsAndConditions    Json?
  signatureImageUrl     String?
  authorizedName        String?
  authorizedDesignation String?
  status                POStatus  @default(DRAFT)
  createdById           String
  approvedById          String?
  approvedAt            DateTime?
  createdAt             DateTime  @default(now())
  updatedAt             DateTime  @updatedAt

  project    Project              @relation(fields: [projectId], references: [id])
  pr         PurchaseRequisition? @relation(fields: [prId], references: [id])
  vendor     Vendor               @relation(fields: [vendorId], references: [id])
  createdBy  User                 @relation("POCreatedBy", fields: [createdById], references: [id])
  approvedBy User?                @relation("POApprovedBy", fields: [approvedById], references: [id])
  items      PurchaseOrderItem[]
  grns       GoodsReceivedNote[]

  @@unique([projectId, poNumber])
  @@index([projectId])
  @@index([vendorId])
  @@index([status])
  @@map("purchase_orders")
}

model PurchaseOrderItem {
  id            String   @id @default(uuid())
  poId          String
  costCodeId    String?
  description   String
  unit          Unit
  qty           Decimal  @db.Decimal(14, 2)
  rate          Decimal  @db.Decimal(14, 2)
  amount        Decimal  @default(0) @db.Decimal(14, 2)
  gstPercent    Decimal  @default(0) @db.Decimal(5, 2)
  gstAmount     Decimal  @default(0) @db.Decimal(14, 2)
  extendedPrice Decimal  @default(0) @db.Decimal(14, 2)
  remarks       String?
  sortOrder     Int      @default(0)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  po       PurchaseOrder @relation(fields: [poId], references: [id], onDelete: Cascade)
  costCode CostCode?     @relation(fields: [costCodeId], references: [id])

  @@index([poId])
  @@map("po_items")
}

/// grnNumber is auto-generated (via DocumentSequence, unique per project)
/// — the design brief's document-numbering section didn't override GRN
/// with a manual-entry instruction the way it did for PR/PO.
model GoodsReceivedNote {
  id                   String    @id @default(uuid())
  projectId            String
  poId                 String
  grnNumber            String
  /// The printed "GRN Date" field — distinct from createdAt, same
  /// reasoning as PurchaseOrder.poDate.
  grnDate              DateTime  @default(now())
  supplierName         String?
  receiptDate          DateTime?
  challanNumber        String?
  challanDate          DateTime?
  lrNumber             String?
  lrDate               DateTime?
  transporterName      String?
  status               GRNStatus @default(DRAFT)
  submittedById        String?
  currentApproverId    String?
  submittedAt          DateTime?
  decidedAt            DateTime?
  /// Set once "Update Inventory" (a separate, manual, post-approval
  /// action per the design brief) has been applied — guards against
  /// double-crediting working stock if clicked more than once.
  inventoryUpdatedAt   DateTime?
  inventoryUpdatedById String?
  createdAt            DateTime  @default(now())
  updatedAt            DateTime  @updatedAt

  project               Project                 @relation(fields: [projectId], references: [id])
  po                    PurchaseOrder           @relation(fields: [poId], references: [id])
  submittedBy           User?                   @relation("GRNSubmittedBy", fields: [submittedById], references: [id])
  currentApprover       User?                   @relation("GRNCurrentApprover", fields: [currentApproverId], references: [id])
  inventoryUpdatedBy    User?                   @relation("GRNInventoryUpdatedBy", fields: [inventoryUpdatedById], references: [id])
  items                 GoodsReceivedNoteItem[]
  inventoryTransactions InventoryTransaction[]

  @@unique([projectId, grnNumber])
  @@index([projectId])
  @@index([poId])
  @@index([status])
  @@map("goods_received_notes")
}

model GoodsReceivedNoteItem {
  id                String   @id @default(uuid())
  grnId             String
  costCodeId        String?
  description       String
  unit              Unit
  qtyAsPerChallan   Decimal  @db.Decimal(14, 2)
  actualQtyReceived Decimal  @db.Decimal(14, 2)
  acceptedQty       Decimal  @db.Decimal(14, 2)
  rejectedQty       Decimal  @default(0) @db.Decimal(14, 2)
  remarks           String?
  sortOrder         Int      @default(0)
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  grn      GoodsReceivedNote @relation(fields: [grnId], references: [id], onDelete: Cascade)
  costCode CostCode?         @relation(fields: [costCodeId], references: [id])

  @@index([grnId])
  @@map("grn_items")
}

/// Generic approval-history log shared by PR/PO/GRN (documentType +
/// documentId, not a Prisma relation — see file header comment). One row
/// per SUBMIT/APPROVE/REJECT/RETURN action.
model Approval {
  id           String             @id @default(uuid())
  documentType ProcurementDocType
  documentId   String
  action       ApprovalAction
  actedById    String?
  comments     String?
  createdAt    DateTime           @default(now())

  actedBy User? @relation("ApprovalActedBy", fields: [actedById], references: [id])

  @@index([documentType, documentId])
  @@map("approvals")
}

model Notification {
  id           String              @id @default(uuid())
  userId       String
  type         NotificationType
  title        String
  message      String
  documentType ProcurementDocType?
  documentId   String?
  channel      NotificationChannel @default(DASHBOARD)
  isRead       Boolean             @default(false)
  createdAt    DateTime            @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([isRead])
  @@map("notifications")
}

model Attachment {
  id           String              @id @default(uuid())
  ownerType    AttachmentOwnerType
  ownerId      String
  fileName     String
  fileUrl      String
  fileType     String?
  uploadedById String?
  createdAt    DateTime            @default(now())

  uploadedBy User? @relation("AttachmentUploadedBy", fields: [uploadedById], references: [id])

  @@index([ownerType, ownerId])
  @@map("attachments")
}

/// Atomic per-project counters backing requestNumber (PR) and grnNumber
/// (GRN) generation. PO is excluded — poNumber is fully manual.
model DocumentSequence {
  id         String             @id @default(uuid())
  projectId  String
  type       ProcurementDocType
  lastNumber Int                @default(0)
  updatedAt  DateTime           @updatedAt

  project Project @relation(fields: [projectId], references: [id])

  @@unique([projectId, type])
  @@map("document_sequences")
}

// ─────────────────────────────────────────────────────────────────────────
// BILLING STATUS
// ─────────────────────────────────────────────────────────────────────────

/// One header per project + billing month/year + optional period range.
/// Deliberately NOT unique on (projectId, billingMonth, billingYear) —
/// a project can have several records for the same month when billing is
/// split into sub-periods (e.g. 1-15 and 16-31 March), each tracked
/// separately per the business's real paper-based billing sheets.
model BillingRecord {
  id           String    @id @default(uuid())
  projectId    String
  billingMonth Int
  billingYear  Int
  periodFrom   DateTime?
  periodTo     DateTime?
  createdById  String
  updatedById  String?
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  project   Project       @relation(fields: [projectId], references: [id])
  createdBy User          @relation("BillingRecordCreatedBy", fields: [createdById], references: [id])
  updatedBy User?         @relation("BillingRecordUpdatedBy", fields: [updatedById], references: [id])
  items     BillingItem[]

  @@index([projectId])
  @@index([billingMonth, billingYear])
  @@map("billing_records")
}

/// One row per plant/unit bill. The same row is edited in place as its
/// status progresses (Pending Certification -> A1 Pending -> A2 Pending ->
/// Accounts Pending -> Invoice Done) rather than duplicated on every status
/// change — the row's own id is the stable reference the audit trail
/// (AuditLog.details, module BILLING_STATUS) keys off.
model BillingItem {
  id              String            @id @default(uuid())
  billingRecordId String
  srNo            Int
  plantUnit       String
  invoiceNo       String?
  jmsNo           String?
  abstractAmount  Decimal           @db.Decimal(14, 2)
  taxAmount       Decimal           @default(0) @db.Decimal(14, 2)
  /// Always server-computed as abstractAmount + taxAmount — never trust a
  /// client-submitted total, same rule PR/PO totals follow.
  totalAmount     Decimal           @default(0) @db.Decimal(14, 2)
  status          BillingItemStatus @default(PENDING_CERTIFICATION)
  createdById     String
  updatedById     String?
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt

  billingRecord BillingRecord @relation(fields: [billingRecordId], references: [id], onDelete: Cascade)
  createdBy     User          @relation("BillingItemCreatedBy", fields: [createdById], references: [id])
  updatedBy     User?         @relation("BillingItemUpdatedBy", fields: [updatedById], references: [id])

  @@index([billingRecordId])
  @@index([status])
  @@map("billing_items")
}

// ─────────────────────────────────────────────────────────────────────────
// SITE ACCOUNTS
// ─────────────────────────────────────────────────────────────────────────

/// The static F01-F24 cost-code/particulars hierarchy from the reference
/// "Forays Account Statement" template — a separate master from
/// Procurement's CostCode (that one is a flat inventory/PO/GRN lookup;
/// this one is a fixed, ordered, protected hierarchy with parent/child
/// grouping used only to lay out the Site Accounts statement). Rows are
/// seeded/self-healed by syncSiteAccountCostCodes() on server startup
/// (same pattern as templateSync.ts's built-in wage templates) rather than
/// hand-edited — normal users never modify this table.
model SiteAccountCostCode {
  id           String   @id @default(uuid())
  code         String   @unique
  description  String
  /// Null for the 24 top-level groups (F01, F02, ... F24); set to the
  /// owning group's code for a child row (e.g. F01I.parentCode = "F01").
  parentCode   String?
  /// Matches the reference statement's row order exactly (multiples of 10
  /// so a future child/group can be inserted without renumbering everything).
  displayOrder Int
  /// True only on F01, F02 and F03 — the only groups the reference
  /// statement renders a "Subtotal" row after. Purely a display/aggregation
  /// flag; the Subtotal row itself is computed on read, never stored, and
  /// is never folded into Total Payments (see SiteAccountEntry comment).
  hasSubtotal  Boolean  @default(false)
  active       Boolean  @default(true)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  entries SiteAccountEntry[]

  @@index([parentCode])
  @@map("site_account_cost_codes")
}

/// One statement header per project + statement period. "Plant/Site",
/// "Project No." and "Name of Job" from the reference template are all
/// pulled live from the linked Project (projectName/projectNumber) rather
/// than duplicated here — only genuinely statement-specific header fields
/// live on this model.
model SiteAccountStatement {
  id               String                     @id @default(uuid())
  projectId        String
  statementDate    DateTime
  periodFrom       DateTime
  periodTo         DateTime
  /// Denormalized from periodFrom purely for the Month/Year filter the
  /// design brief asks for — same convention as BillingRecord's
  /// billingMonth/billingYear.
  statementMonth   Int
  statementYear    Int
  /// "Opening Balance" and "Amount Received as site fund" are the reference
  /// template's two fixed, always-present receipt rows — modeled as direct
  /// fields (not SiteAccountEntry rows) per the design brief's own
  /// suggestion to store Opening Balance "as a separate field ... rather
  /// than treating it as a normal expense transaction", so it can never be
  /// counted as a payment or duplicated as a generic entry.
  openingBalance   Decimal                    @default(0) @db.Decimal(14, 2)
  siteFundReceived Decimal                    @default(0) @db.Decimal(14, 2)
  status           SiteAccountStatementStatus @default(DRAFT)
  createdById      String
  updatedById      String?
  createdAt        DateTime                   @default(now())
  updatedAt        DateTime                   @updatedAt

  project   Project            @relation(fields: [projectId], references: [id])
  createdBy User               @relation("SiteAccountStatementCreatedBy", fields: [createdById], references: [id])
  updatedBy User?              @relation("SiteAccountStatementUpdatedBy", fields: [updatedById], references: [id])
  entries   SiteAccountEntry[]

  @@index([projectId])
  @@index([statementMonth, statementYear])
  @@index([status])
  @@map("site_account_statements")
}

/// One row per transaction line. Multiple entries may share the same
/// costCodeId (e.g. three separate vouchers all posted under F01) — the
/// Excel-style Subtotal/Total figures are always computed by summing these
/// leaf rows, so there is nothing to double-count even though the
/// displayed statement groups several entries under one cost code.
model SiteAccountEntry {
  id                   String               @id @default(uuid())
  statementId          String
  entryType            SiteAccountEntryType
  /// Required for EXPENSE, always null for OTHER_RECEIPT.
  costCodeId           String?
  voucherNo            String?
  /// Free text, only meaningful for OTHER_RECEIPT — an EXPENSE entry's
  /// particulars are always the linked cost code's own description, never
  /// stored redundantly here.
  particulars          String?
  receiptAmount        Decimal              @default(0) @db.Decimal(14, 2)
  depositAdvanceAmount Decimal              @default(0) @db.Decimal(14, 2)
  paymentAmount        Decimal              @default(0) @db.Decimal(14, 2)
  createdById          String
  updatedById          String?
  createdAt            DateTime             @default(now())
  updatedAt            DateTime             @updatedAt

  statement SiteAccountStatement    @relation(fields: [statementId], references: [id], onDelete: Cascade)
  costCode  SiteAccountCostCode?    @relation(fields: [costCodeId], references: [id])
  createdBy User                    @relation("SiteAccountEntryCreatedBy", fields: [createdById], references: [id])
  updatedBy User?                   @relation("SiteAccountEntryUpdatedBy", fields: [updatedById], references: [id])
  dates     SiteAccountEntryDate[]

  @@index([statementId])
  @@index([costCodeId])
  @@map("site_account_entries")
}

/// Normalized transaction dates — a voucher may be dated across several
/// receipts/payments (e.g. "01.03.2026, 05.03.2026"); stored one row per
/// date rather than a comma-joined string, per the design brief's own
/// preference, and joined back into the comma-separated display format
/// only at render/export time.
model SiteAccountEntryDate {
  id      String   @id @default(uuid())
  entryId String
  date    DateTime

  entry SiteAccountEntry @relation(fields: [entryId], references: [id], onDelete: Cascade)

  @@index([entryId])
  @@map("site_account_entry_dates")
}
