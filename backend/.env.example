# Server
NODE_ENV=development
PORT=4000
API_PREFIX=/api/v1
CORS_ORIGIN=http://localhost:5173

# Database
DATABASE_URL="postgresql://hr_app:hr_app_password@localhost:5432/hr_app_db?schema=public"

# JWT
JWT_ACCESS_SECRET=replace_with_a_long_random_secret_for_access_tokens
JWT_REFRESH_SECRET=replace_with_a_long_random_secret_for_refresh_tokens
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

# Security
BCRYPT_SALT_ROUNDS=12
RATE_LIMIT_WINDOW_MS=900000
RATE_LIMIT_MAX=300
LOGIN_RATE_LIMIT_MAX=10

# Seed
SUPER_ADMIN_EMAIL=admin@foraysgroup.com
SUPER_ADMIN_PASSWORD=ChangeMe@12345

# Public base URL this API is reachable at — used to build the email
# open-tracking pixel URL and WhatsApp attachment links. Must be a real
# public HTTPS URL in production for tracking/WhatsApp media to work.
APP_BASE_URL=http://localhost:4000

# Bulk Communication — Email (SMTP). Leave unset to run with sending
# disabled (everything else works; sends fail with a clear reason).
# Works with Gmail (use an App Password), Office365, or any SMTP relay
# in front of SendGrid/SES/Postmark.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM_ADDRESS=
SMTP_FROM_NAME=Forays Group HR Solutions

# Bulk Communication — WhatsApp (Meta Cloud API). Leave unset to run with
# sending disabled. Requires a Meta Business + WhatsApp Business Account.
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_API_VERSION=v20.0
WHATSAPP_WEBHOOK_VERIFY_TOKEN=

# Bulk Communication — queue worker tuning (sane defaults, rarely need changing)
COMM_QUEUE_POLL_INTERVAL_MS=5000
COMM_QUEUE_BATCH_SIZE=25
COMM_QUEUE_MAX_ATTEMPTS=3
